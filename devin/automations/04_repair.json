{
  "name": "flowstate/repair",
  "enabled": true,
  "run_as": {
    "type": "creator"
  },
  "metadata": {
    "pipeline": "flowstate",
    "stage": "repair"
  },
  "triggers": [
    {
      "event_type": "github:pull_request_review",
      "conditions": {
        "any": [
          {
            "all": [
              {
                "field": "repository.full_name",
                "operator": "eq",
                "value": "{{REPO}}"
              },
              {
                "field": "pull_request.head.ref",
                "operator": "starts_with",
                "value": "devin/"
              },
              {
                "field": "review.state",
                "operator": "eq",
                "value": "changes_requested"
              },
              {
                "field": "action",
                "operator": "eq",
                "value": "submitted"
              }
            ]
          }
        ]
      },
      "replies": [
        {
          "type": "post_response"
        }
      ]
    },
    {
      "event_type": "github:pull_request_review_comment",
      "conditions": {
        "any": [
          {
            "all": [
              {
                "field": "repository.full_name",
                "operator": "eq",
                "value": "{{REPO}}"
              },
              {
                "field": "pull_request.head.ref",
                "operator": "starts_with",
                "value": "devin/"
              },
              {
                "field": "action",
                "operator": "eq",
                "value": "created"
              },
              {
                "field": "comment.user.login",
                "operator": "neq",
                "value": "devin-ai-integration[bot]"
              }
            ]
          }
        ]
      },
      "replies": [
        {
          "type": "post_response"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "start_session",
      "prompt": "You are the REPAIR stage of the Flowstate pipeline for {{REPO_AT}} \u2014 Builder playbook @playbook:{{BUILDER_PLAYBOOK_ID}} in REPAIR mode.\n\nThe event payload below is a review or review comment on a pipeline PR. Check out the PR's head branch and gather ALL currently unaddressed reviewer findings \u2014 the triggering event plus any other open review comments, since one review round can fire several triggers. The PR body carries the task context and a 'Slack-Thread: <channel>/<ts>' line for your report. If the latest commits already address every finding, post a short note and stop: do not push a duplicate fix.\n\nApply only the fixes the findings require, re-run the affected checks (npm run typecheck + relevant tests), and push with a 'repair:' prefixed commit message. Post a short REPAIR report in the Slack thread (channel fallback if no Slack-Thread line).\n\nLoop guard: if the branch already has 2 or more 'repair:' commits, post 'BUILDER: ESCALATE \u2014 repeated failure after N repair rounds' instead of pushing again.",
      "session": {
        "bypass_approval": true,
        "tags": [
          "flowstate-pipeline",
          "stage-repair"
        ],
        "notifications": {
          "slack": {
            "mode": "post_updates",
            "channel_id": "{{CHANNEL_ID}}"
          }
        }
      }
    }
  ],
  "tools": {
    "slack_channels": [
      {
        "team_id": "{{TEAM_ID}}",
        "channel_id": "{{CHANNEL_ID}}"
      }
    ]
  },
  "session_settings": {
    "devin_mode": "normal"
  },
  "limits": {
    "max_acu_limit": 40,
    "invocations": {
      "max_per_window": 8,
      "window_seconds": 3600
    }
  },
  "concurrency": {
    "max_concurrent_runs": 1,
    "max_queue_depth": 10
  }
}
