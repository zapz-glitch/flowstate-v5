{
  "manifest_version": 3,
  "name": "Flowstate — Send Address",
  "version": "1.1.0",
  "description": "Right-click any selected address to send it to Flowstate Property Research.",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  }
}
