{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowstate-dashboard",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Environment Variables
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api.flowstate.homes",
    "NEXT_PUBLIC_GOOGLE_MAP_KEY": "AIzaSyD1mztBbiP93zRqPiUiV0Upk7uM435EQDU"
  },
  // Observability
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
  // Secrets (set via wrangler secret put):
  // - DASHBOARD_INTERNAL_SECRET (shared with API for session-based auth)
}