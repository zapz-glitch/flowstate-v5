# Development-only image for the V4 dashboard runtime.
#
# Baked `npm ci` + `next dev` on port 3000. Repo code is copied at build
# time, so re-run `./scripts/runtime up` (which builds) after changing
# dashboard code. Dashboard `.env*` files are EXCLUDED from the build context
# by the root .dockerignore, so public build-time values are injected via
# Compose environment (NEXT_PUBLIC_API_URL in compose.dev.yaml). Map embeds
# show a "not configured" placeholder when NEXT_PUBLIC_GOOGLE_MAP_KEY is
# unset.

FROM node:22-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json turbo.json ./
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
COPY apps/dashboard ./apps/dashboard

RUN node -e 'const fs=require("fs"); for(const p of [".data", "apps/api/.dev.vars", "apps/dashboard/.env.production", "apps/dashboard/.env.development"]) if(fs.existsSync(p)) throw Error("Local credentials entered build context");'
RUN npm ci

ENV PORT=3000 HOSTNAME=0.0.0.0

EXPOSE 3000

CMD ["npm", "run", "dev", "--workspace", "@flowstate-api/dashboard", "--", "--port", "3000", "--hostname", "0.0.0.0"]
