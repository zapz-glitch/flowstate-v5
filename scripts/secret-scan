#!/bin/sh
set -eu

cd "$(dirname "$0")/.."

patterns='(-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----|sk-or-v1-[A-Za-z0-9]{20,}|Authorization:[[:space:]]*Bearer[[:space:]]+[A-Za-z0-9_-]{32,})'

files=$(
  {
    git ls-files
    git ls-files --others --exclude-standard
  } | sort -u
)

if [ -n "$files" ] && printf '%s\n' "$files" | xargs -d '\n' grep -nI -E "$patterns" --; then
  echo "secret-scan: credential-shaped tracked content found" >&2
  exit 1
fi

echo "secret-scan: tracked and untracked working tree files passed"
